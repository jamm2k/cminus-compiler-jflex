/* Programa que soma elementos de um array */

int soma(int arr[], int n) {
    int i;
    int s;
    s = 0;
    i = 0;
    while (i < n) {
        s = s + arr[i];
        i = i + 1;
    }
    return s;
}

void main(void) {
    int nums[5];
    int i;
    i = 0;
    while (i < 5) {
        nums[i] = input();
        i = i + 1;
    }
    output(soma(nums, 5));
}